VITE_PUBLIC_PATH=./

# dashboard 主服务网关路径前缀（IC 网关下 dashboard 服务）
VITE_APP_BASE_API = dashboard

# ===== 登录相关：IC 网关（device/dashboard 服务） =====
VITE_APP_SERVER_HOST = http://10.89.33.97
VITE_APP_SERVER_PORT = 29021
VITE_APP_IC_HOST = 10.89.33.97
VITE_APP_IC_PORT = 39100

# ===== Dify 会话 / 后台配置 / 上传 / WS（迁移自 dashboard） =====
# 会话历史服务地址（对话列表 /session/list 直连）
VITE_APP_DIFY_SESSION_HOST = http://10.89.33.97:8081
# 后台配置服务地址（AI-Assistant Swagger，多张表 CRUD）
VITE_APP_BACKEND_CONFIG_HOST = http://10.89.33.97:8082
# 对话 WebSocket 服务地址（/ws/chat）
VITE_APP_DIFY_WS_HOST = ws://10.89.33.97:8081
# 附件上传服务地址（/api/file/upload/batch）
VITE_APP_DIFY_UPLOAD_HOST = http://10.89.33.97:8081
# 来源系统标识（上传/WS 接口的 X-Src-System 请求头）
VITE_APP_DIFY_SRC_SYSTEM = zutai01

# MCP 图片服务地址（answer 中占位符真实值）
VITE_APP_MCP_HOST = 10.89.33.96
VITE_APP_MCP_PORT = 8001

# 文件类型 → 查看器 base（SQL 结果表格文件路径链接化）
VITE_APP_MARKDOWN_LINK_BASE = "http://10.89.33.97:3344/#/markdown/"
# VITE_APP_PDF_LINK_BASE = "http://10.89.33.97:3344/#/pdf/"
# 文件类型 2（图片）：查看器 base，拼接后为 http://10.89.33.94:6180/remote.html?fullObjectPath=/{路径}
VITE_APP_IMAGE_LINK_BASE = "http://10.89.33.94:6180/remote.html?fullObjectPath=/"
# 文件类型 3（视频）：查看器 base，拼接后为 http://10.89.33.94:8081/video/?path=/{目录路径}
VITE_APP_VIDEO_LINK_BASE = "http://10.89.33.94:8081/video/?path=/"
